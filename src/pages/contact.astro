---
import BaseLayout from '@layouts/BaseLayout.astro';

const contact = {
  email: 'rs28102058@gmail.com',
  whatsapp: '+977 9716100765',
  whatsappLink: 'https://wa.me/9779716100765',
  linkedin: 'https://www.linkedin.com/in/rohit-sah-202026229/',
};
---

<BaseLayout title="Contact" description="Contact Rohit Kumar Sah — freelance electrical engineer based in Banepa, Nepal. WhatsApp, email and LinkedIn.">
  <section class="contact section">
    <div class="container">
      <div class="section-header" style="margin-bottom: 3rem;">
        <span class="section-number">01</span>
        <h1 style="font-size: 2.5rem; color: var(--ink); margin: 0;">Get in touch</h1>
      </div>

      <div class="contact-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start;">
        <div>
          <div class="glass-card scroll-reveal" style="margin-bottom: 2rem;">
            <h2 style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--ink); margin: 0 0 1.5rem;">How we can work together</h2>
            <p style="color: var(--muted); margin: 0 0 1.5rem; line-height: 1.8;">
              I work remotely — calculations, studies, drawings and online tutoring. No site visits.
            </p>
            <ul style="color: var(--muted); margin: 0; padding-left: 1.5rem; line-height: 2;">
              <li>Send your project brief, appliance list or single-line sketch</li>
              <li>I reply with assumptions, scope and a fixed price before starting</li>
              <li>We agree, I deliver the files, you review, I fix anything that doesn't match</li>
              <li>Where a job needs a registered engineer's stamp or on-site inspection, I tell you at the start</li>
            </ul>
          </div>

          <div class="glass-card scroll-reveal">
            <h2 style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--ink); margin: 0 0 1.5rem;">What I need from you</h2>
            <ul style="color: var(--muted); margin: 0; padding-left: 1.5rem; line-height: 2;">
              <li>Project type and rough scope</li>
              <li>Appliance list, floor plan or existing drawings (if any)</li>
              <li>Location (for NEA standards, solar irradiance, earthing conditions)</li>
              <li>Timeline and budget range</li>
            </ul>
          </div>
        </div>

        <div>
          <div class="contact-methods">
            <a href={contact.whatsappLink} class="contact-card glass-card scroll-reveal" style="display: block; text-decoration: none; margin-bottom: 1.5rem;" target="_blank" rel="noopener noreferrer">
              <div style="display: flex; align-items: center; gap: 1rem;">
                <div style="width: 56px; height: 56px; border-radius: 16px; background: #25D366; display: flex; align-items: center; justify-content: center;">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="white" style="margin-left: 2px;">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.454.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378 3.43 3.43 0 00-.316-.579C2.557 19.59.85 17.487.51 14.91a10.03 10.03 0 013.268-6.733c.754-.753 1.752-1.262 2.941-1.474.185-.033.372-.052.558-.052h.004c2.224 0 4.134.86 5.61 2.34a9.88 9.88 0 012.34 5.738c-.026.797-.2 1.58-.443 2.326-.322.98-.815 1.747-1.476 2.206-.567.39-1.22.63-1.924.763-.575.108-2.06.167-3.3.043-.133-.012-.265-.023-.397-.033z"/>
                  </svg>
                </div>
                <div>
                  <p style="color: var(--muted); font-size: 0.85rem; margin: 0 0 0.25rem;">WhatsApp</p>
                  <p style="color: var(--ink); font-weight: 600; margin: 0;">{contact.whatsapp}</p>
                </div>
              </div>
            </a>

            <a href={`mailto:${contact.email}`} class="contact-card glass-card scroll-reveal" style="display: block; text-decoration: none; margin-bottom: 1.5rem;">
              <div style="display: flex; align-items: center; gap: 1rem;">
                <div style="width: 56px; height: 56px; border-radius: 16px; background: var(--navy); display: flex; align-items: center; justify-content: center; border: 1px solid var(--glass-border);">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                </div>
                <div>
                  <p style="color: var(--muted); font-size: 0.85rem; margin: 0 0 0.25rem;">Email</p>
                  <p style="color: var(--ink); font-weight: 600; margin: 0;">{contact.email}</p>
                </div>
              </div>
            </a>

            <a href={contact.linkedin} class="contact-card glass-card scroll-reveal" style="display: block; text-decoration: none;" target="_blank" rel="noopener noreferrer">
              <div style="display: flex; align-items: center; gap: 1rem;">
                <div style="width: 56px; height: 56px; border-radius: 16px; background: #0A66C2; display: flex; align-items: center; justify-content: center;">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </div>
                <div>
                  <p style="color: var(--muted); font-size: 0.85rem; margin: 0 0 0.25rem;">LinkedIn</p>
                  <p style="color: var(--ink); font-weight: 600; margin: 0;">Rohit Kumar Sah</p>
                </div>
              </div>
            </a>
          </div>

          <div class="glass-card scroll-reveal" style="margin-top: 2rem; padding: 2rem;">
            <h2 style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--ink); margin: 0 0 1rem;">Quick actions</h2>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
              <a href={contact.whatsappLink} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Open WhatsApp</a>
              <a href={`mailto:${contact.email}?subject=Freelance inquiry`} class="btn btn-outline">Compose email</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>