                <td style="text-align: center; padding: 1rem; color: var(--muted);">-4.321</td>
                <td style="text-align: center; padding: 1rem; color: var(--muted);">50.00</td>
                <td style="text-align: center; padding: 1rem; color: var(--muted);">38.72</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--glass-border);">
