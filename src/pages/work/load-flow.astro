                <td style="text-align: center; padding: 1rem; color: var(--muted);">-6.105</td>
                <td style="text-align: center; padding: 1rem; color: var(--muted);">0</td>
                <td style="text-align: center; padding: 1rem; color: var(--muted);">0</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--glass-border);">
                <td style="padding: 1rem; color: var(--ink);">4</td>
                <td style="text-align: center; padding: 1rem; color: var(--muted);">0.9752</td>
                <td style="text-align: center; padding: 1rem; color: var(--muted);">-5.832</td>
                <td style="text-align: center; padding: 1rem; color: var(--muted);">0</td>
                <td style="text-align: center; padding: 1rem; color: var(--muted);">0</td>
