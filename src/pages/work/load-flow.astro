                <td style="text-align: center; padding: 1rem; color: var(--muted);">168.42</td>
                <td style="text-align: center; padding: 1rem; color: var(--muted);">24.18</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--glass-border);">
                <td style="padding: 1rem; color: var(--ink);">2</td>
