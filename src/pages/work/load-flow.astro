                <td style="text-align: center; padding: 1rem; color: var(--muted);">0</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="glass-card scroll-reveal" style="margin-bottom: 3rem;">
        <h2 style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--ink); margin: 0 0 1.5rem;">Download files</h2>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <a href="/content/samples/sample-5bus-load-flow.xlsx" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem;">Excel workbook</a>
          <a href="/content/samples/solve_loadflow.m" class="btn btn-outline" style="display: inline-flex; align-items: center; gap: 0.5rem;">MATLAB script</a>
        </div>
      </div>

      <!-- Back link -->
      <a href={`${BASE}work/`} class="btn btn-outline" style="display: inline-flex; align-items: center; gap: 0.5rem;">← Back to Work</a>
    </div>
