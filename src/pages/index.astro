---
import BaseLayout from '@layouts/BaseLayout.astro';
import BlueprintGrid from '@components/BlueprintGrid.astro';
import { getCollection } from 'astro:content';

const siteCopy = await getCollection('site-copy');
const BASE = import.meta.env.BASE_URL;

// Use the content from site-copy.md
const heroHeadline = "Electrical calculations, drawings and simulation, explained clearly.";
const heroSubhead = "Load calculations, load flow studies, cable and breaker sizing, solar PV sizing and MATLAB/Simulink work for homes, small buildings, students and engineering teams. Based in Banepa, working remotely.";
const heroButtons = [
  { text: 'See sample work', href: `${BASE}work/` },
  { text: 'WhatsApp me: +977 9716100765', href: 'https://wa.me/9779716100765' },
  { text: 'Email me: rs28102058@gmail.com', href: 'mailto:rs28102058@gmail.com' },
];

const servicesShort = [
  'Load flow (power flow) studies',
  'Load calculation and demand estimation',
  'Cable sizing, voltage drop and MCB selection',
  'Solar PV and battery sizing',
  'Earthing calculations',
  'Single-line diagrams and electrical drawings',
  'MATLAB/Simulink modelling and simulation',
  'Technical tutoring and training',
];

const selectedWork = [
  {
    title: 'Academic project',
    items: [
      `Comparing PID, ANFIS and lead-lag stabilizers for generator voltage control (team of five, final-year project, 2025). <a href="${BASE}work/avr-pss/" class="text-link">Read the case study</a>`,
    ],
  },
  {
    title: 'Sample deliverables (worked examples, not client projects)',
    items: [
      `5-bus Newton-Raphson load flow: workbook, MATLAB script, network diagram with bus voltages and flows, convergence chart, and a short write-up. <a href="${BASE}work/load-flow/" class="text-link">Read the case study</a>`,
      'Load calculation, cable/MCB schedule and solar sizing workbook for a fictional 3-bedroom house in Banepa',
      'Single-line diagram for the same house',
    ],
    badge: true,
  },
];

const howIWork = [
  { step: '1', title: 'Brief', text: 'You send a plan, appliance list or description. I ask only what I need.' },
  { step: '2', title: 'Assumptions', text: 'I write down every assumption and agree it with you before calculating.' },
  { step: '3', title: 'Calculation', text: 'I prepare the sheets or drawings, with formulas you can inspect.' },
  { step: '4', title: 'Review', text: 'I walk you through the results and fix anything that doesn\'t match your site.' },
  { step: '5', title: 'Handover', text: 'You receive the files and a short summary.' },
];

const contact = {
  email: 'rs28102058@gmail.com',
  whatsapp: '+977 9716100765',
  whatsappLink: 'https://wa.me/9779716100765',
  linkedin: 'https://www.linkedin.com/in/rohit-sah-202026229/',
};
---

<BaseLayout title="Home" description="Electrical calculations, drawings and simulation, explained clearly. Freelance electrical engineer based in Banepa, Nepal. Working remotely.">
  <BlueprintGrid />

  <!-- Hero -->
  <section class="hero section scroll-reveal" style="position: relative; padding: 6rem 0 4rem;">
    <div class="container">
      <div class="hero-grid" style="display: grid; grid-template-columns: 1fr 420px; gap: 3rem; align-items: center;">
        <div>
          <p class="hero-kicker" style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--amber); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem;">Freelance · Electrical Engineering · Banepa, Nepal</p>
          <h1 style="font-family: var(--font-heading); font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 700; line-height: 1.1; margin: 0 0 1.5rem; color: var(--ink);">
            {heroHeadline}
          </h1>
          <p class="hero-subhead" style="font-size: 1.15rem; color: var(--muted); margin: 0 0 2rem; max-width: 520px;">
            {heroSubhead}
          </p>
          <div class="hero-actions" style="display: flex; gap: 1rem; flex-wrap: wrap;">
            {heroButtons.map((btn) => {
              const isPrimary = btn.text.startsWith('See sample');
              const isExternal = btn.href.startsWith('http');
              return (
                <a href={btn.href} class={`btn ${isPrimary ? 'btn-primary' : 'btn-outline'}`} {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                  {btn.text}
                </a>
              );
            })}
          </div>
        </div>
        <div class="hero-photo" style="position: relative;">
          <img src="/content/images/profile.jpg" alt="Rohit Kumar Sah - Electrical Engineer" style="width: 100%; border-radius: 20px; border: 3px solid var(--amber-soft); box-shadow: 0 20px 60px rgba(255, 183, 3, 0.25); display: block;" />
          <div class="glow-ring" style="position: absolute; inset: -10px; border-radius: 30px; border: 1px solid var(--amber); opacity: 0.4; animation: pulse 3s ease-in-out infinite;"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Strip -->
  <section class="trust-strip section">
    <div class="container">
      <div class="trust-grid">
        <span class="trust-item">BE Electrical, TU (2025)</span>
        <span class="trust-separator">·</span>
        <span class="trust-item">Instructor, Banepa Polytechnic</span>
        <span class="trust-separator">·</span>
        <span class="trust-item">Based in Banepa, Nepal</span>
        <span class="trust-separator">·</span>
        <span class="trust-item">Online and remote</span>
      </div>
    </div>
  </section>

  <!-- Services Short -->
  <section class="services-short section" style="background: var(--navy-dim);">
    <div class="container">
      <div class="section-header" style="display: flex; align-items: baseline; gap: 1rem; margin-bottom: 3rem;">
        <span class="section-number">01</span>
        <h2 style="font-size: 2rem; color: var(--ink); margin: 0;">Services I offer</h2>
      </div>
      <div class="services-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem;">
        {servicesShort.map((s) => (
          <div class="glass-card scroll-reveal">
            <h3 style="font-size: 1rem; color: var(--ink); margin: 0 0 0.5rem; font-weight: 600;">{s}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Selected Work -->
  <section class="selected-work section">
    <div class="container">
      <div class="section-header" style="display: flex; align-items: baseline; gap: 1rem; margin-bottom: 3rem;">
        <span class="section-number">02</span>
        <h2 style="font-size: 2rem; color: var(--ink); margin: 0;">Selected work</h2>
      </div>
      {selectedWork.map((group) => (
        <div class="work-group" style="margin-bottom: 3rem;">
          <h3 style="font-family: var(--font-heading); font-size: 1.25rem; color: var(--ink); margin: 0 0 1rem; padding-left: 0.75rem; border-left: 3px solid var(--amber);">{group.title}</h3>
          <ul style="list-style: none; padding: 0; margin: 0;">
            {group.items.map((item) => (
              <li style="margin-bottom: 1rem; color: var(--muted); line-height: 1.7;">
                <span set:html={item} />
                {group.badge && <span class="badge-todo">Worked example, not a client project</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- How I Work -->
  <section class="how-i-work section">
    <div class="container">
      <div class="section-header" style="display: flex; align-items: baseline; gap: 1rem; margin-bottom: 3rem;">
        <span class="section-number">03</span>
        <h2 style="font-size: 2rem; color: var(--ink); margin: 0;">How I work</h2>
      </div>
      <div class="work-steps" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem;">
        {howIWork.map((step) => (
          <div class="glass-card scroll-reveal" style="text-align: center;">
            <div class="step-number" style="font-family: var(--font-mono); font-size: 1.75rem; font-weight: 700; color: var(--amber); margin-bottom: 1rem;">{step.step}</div>
            <h4 style="font-size: 1.1rem; color: var(--ink); margin: 0 0 0.75rem;">{step.title}</h4>
            <p style="color: var(--muted); font-size: 0.95rem; margin: 0;">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="contact-cta section" style="text-align: center; padding: 5rem 0;">
    <div class="container">
      <h2 style="font-size: 2rem; color: var(--ink); margin: 0 0 1rem;">Ready to work together?</h2>
      <p style="color: var(--muted); margin: 0 0 2rem;">I take freelance work remotely only — calculations, studies, drawings and online tutoring.</p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href={contact.whatsappLink} class="btn btn-primary" target="_blank" rel="noopener noreferrer">WhatsApp me</a>
        <a href={`mailto:${contact.email}`} class="btn btn-outline">Email me</a>
        <a href={contact.linkedin} class="btn btn-outline" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
  </section>

  <style>
    .hero-photo {
      position: relative;
    }
    .glow-ring {
      pointer-events: none;
    }
    .work-group ul li {
      padding-left: 0;
    }
    .work-group ul li a {
      color: var(--amber);
    }
    .work-group ul li a:hover {
      text-decoration: underline;
    }
    @media (max-width: 768px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }
      .hero-photo {
        order: -1;
        max-width: 280px;
        margin: 0 auto 2rem;
      }
    }
    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 0.4; }
      50% { transform: scale(1.05); opacity: 0.2; }
    }
  </style>
</BaseLayout>