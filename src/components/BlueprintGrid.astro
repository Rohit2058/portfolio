---
// BlueprintGrid.astro - animated SVG background pattern
---

<svg class="blueprint-grid" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
  <defs>
    <pattern id="grid" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="var(--muted)" stroke-width="0.5" opacity="0.3" />
    </pattern>
    <pattern id="grid-dots" x="0" y="0" width="80" height="80" patternUnits="userSpaceOnUse">
      <circle cx="40" cy="40" r="1" fill="var(--amber)" opacity="0.2" />
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#grid)" />
  <rect width="100%" height="100%" fill="url(#grid-dots)" opacity="0.4" />
</svg>

<style>
  .blueprint-grid {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.6;
  }
  [data-theme="light"] .blueprint-grid {
    opacity: 0.3;
  }
</style>
