---
// ThemeToggle.astro
---

<button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark/light theme" title="Toggle theme">
  <span class="theme-icon sun">☀️</span>
  <span class="theme-icon moon">🌙</span>
</button>

<style>
  .theme-toggle {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 200;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    background: var(--glass);
    color: var(--ink);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    transition: all 0.2s ease;
    backdrop-filter: blur(8px);
  }
  .theme-toggle:hover {
    border-color: var(--amber);
    transform: rotate(-15deg);
  }
  .theme-icon {
    display: none;
  }
  .theme-icon.sun {
    display: block;
  }
  [data-theme="dark"] .theme-icon.sun {
    display: none;
  }
  [data-theme="dark"] .theme-icon.moon {
    display: block;
  }
  [data-theme="light"] .theme-icon.moon {
    display: none;
  }
  [data-theme="light"] .theme-icon.sun {
    display: block;
  }
</style>

<script>
  (function () {
    const toggle = document.getElementById('theme-toggle');
    const html = document.documentElement;
    const sunIcon = toggle.querySelector('.theme-icon.sun');
    const moonIcon = toggle.querySelector('.theme-icon.moon');

    function applyTheme(theme) {
      if (theme === 'light') {
        html.setAttribute('data-theme', 'light');
        html.classList.remove('theme-system');
        sunIcon.style.display = 'none';
        moonIcon.style.display = 'block';
      } else if (theme === 'dark') {
        html.removeAttribute('data-theme');
        html.classList.remove('theme-system');
        sunIcon.style.display = 'block';
        moonIcon.style.display = 'none';
      } else {
        html.removeAttribute('data-theme');
        html.classList.add('theme-system');
        const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        sunIcon.style.display = isDark ? 'none' : 'block';
        moonIcon.style.display = isDark ? 'block' : 'none';
      }
    }

    function getSystemTheme() {
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    const stored = localStorage.getItem('theme');
    if (stored) {
      applyTheme(stored);
    } else {
      applyTheme('system');
    }

    toggle.addEventListener('click', () => {
      const current = html.getAttribute('data-theme') || html.classList.contains('theme-system') ? 'system' : html.getAttribute('data-theme') || 'system';
      const next = current === 'system' ? (getSystemTheme() === 'dark' ? 'light' : 'dark') : current === 'dark' ? 'light' : 'system';
      localStorage.setItem('theme', next);
      applyTheme(next);
    });

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (!localStorage.getItem('theme') || localStorage.getItem('theme') === 'system') {
        applyTheme('system');
      }
    });
  })();
</script>
